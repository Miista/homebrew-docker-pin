# The released image. Used by goreleaser, which cross-compiles the binary per
# architecture and copies it in -- which is the only reason this is a separate
# file from cmd/duva/Dockerfile.
#
# Everything else MUST match that file: same base, same layout. The integration
# suites build the other one, so a difference here is a difference between what
# is tested and what ships. That is not hypothetical -- this image was
# distroless-static long after duva started needing git and the docker CLI at
# runtime, and only the tested image would have shown it.
#
# Base images are pinned by digest, the same way this tool asks a compose file
# to pin its own: the tag says which stream to follow, the digest records what
# was actually built. Refreshed deliberately, by resolving the tags again.

# docker:cli carries the docker CLI and git, which duva needs at runtime: it
# pulls images and inspects containers, and commits what it applies.
FROM docker:cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe
# /data must exist in the image: a named volume mounted there inherits this
# directory's ownership on first use, so `- duva-state:/data` works without
# any chown ceremony.
RUN mkdir -p /data
COPY duva /duva
# The approval queue. Reachable only if the operator publishes it; duva always
# listens, since a container's port is invisible until someone maps it.
EXPOSE 8080
ENTRYPOINT ["/duva"]
CMD ["serve"]
